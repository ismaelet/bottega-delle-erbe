# Ignore environment and configuration files
.env
.s3cfg

# Ignore IDE settings
/.vscode/settings.json

# Ignore dependencies
/app/node_modules
/app/vendor

# Ignore build artifacts
/app/public/build
/app/public/hot

# Ignore storage files and the storage symlink
/app/storage/*
!/app/storage/**/
!/app/storage/**/.gitignore

# Ignore legacy files
/legacy