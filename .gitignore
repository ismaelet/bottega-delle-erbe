# Ignore environment and configuration files
.env
.s3cfg

# Ignore IDE settings
/.vscode/settings.json

# Ignore dependencies
/app/node_modules
/app/vendor

# Ignore build artifacts
/app/public/build
/app/public/hot
/app/public/css/filament
/app/public/js/filament
/app/public/fonts/filament

# Ignore storage files and the storage symlink
/app/storage/*
!/app/storage/**/
!/app/storage/**/.gitignore
/app/public/storage

# Ignore legacy files
/legacy